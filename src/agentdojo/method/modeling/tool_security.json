{
  "schema_version": 1,
  "thresholds": {
    "prompt_injection_min_judge_confidence": 0.3,
    "max_risk_evidence": 50,
    "l2_chain_min_confidence": 0.65,
    "outcome_audit_min_confidence": 0.7,
    "unknown_category_level": "secret",
    "unknown_source_integrity": "untrusted",
    "prompt_injection_scan": {
      "threshold": 0.95,
      "mask_urls": false,
      "mask_emails": true
    },
    "field_plan_min_confidence": 0.55,
    "task_egress_min_confidence": 0.7,
    "task_effect_min_confidence": {
      "read": 0.45,
      "write": 0.65,
      "egress": 0.75,
      "privilege": 0.8
    }
  },
  "category_min_level": {
    "credential": "secret",
    "verification_code": "secret",
    "iban": "secret",
    "financial_data": "secret",
    "financial_amount": "confidential",
    "ssn": "secret",
    "credit_card": "secret",
    "personal_name": "confidential",
    "address": "confidential",
    "phone": "confidential",
    "location": "confidential",
    "email": "internal",
    "calendar": "internal",
    "file": "internal"
  },
  "source_kinds": {
    "trusted": [
      "user_prompt",
      "system_prompt",
      "tool_schema",
      "tool_status",
      "internal_config"
    ],
    "external": [
      "external",
      "tool_output",
      "environment",
      "user_pasted_external"
    ],
    "levels": {
      "user_prompt": "internal",
      "system_prompt": "internal",
      "tool_schema": "public",
      "tool_status": "internal",
      "internal_config": "internal",
      "external": "internal",
      "tool_output": "internal",
      "environment": "internal",
      "agent": "internal",
      "activity": "internal",
      "sanitized": "internal"
    }
  },
  "profiles": {
    "read_public": {
      "effect": "read",
      "risk_level": "L0",
      "confidentiality": "public"
    },
    "read_internal": {
      "effect": "read",
      "risk_level": "L0",
      "confidentiality": "internal"
    },
    "read_confidential": {
      "effect": "read",
      "risk_level": "L0",
      "confidentiality": "confidential"
    },
    "read_secret": {
      "effect": "read",
      "risk_level": "L0",
      "confidentiality": "secret"
    },
    "write_internal": {
      "effect": "write",
      "risk_level": "L1",
      "confidentiality": "internal"
    },
    "privilege": {
      "effect": "privilege",
      "risk_level": "L2",
      "confidentiality": "confidential"
    },
    "egress_internal": {
      "effect": "egress",
      "risk_level": "L2",
      "confidentiality": "internal"
