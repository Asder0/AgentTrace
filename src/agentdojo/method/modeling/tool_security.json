      "destination_fields": ["event_id"],
      "implicit_egress": [
        {
          "resource_path": "calendar.events",
          "id_parameter": "event_id",
          "entity": "calendar_event",
          "recipient_field": "participants",
          "content_fields": [
            "title",
            "description",
            "start_time",
            "end_time",
            "location",
            "participants"
          ]
        }
